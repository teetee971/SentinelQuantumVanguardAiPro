# Never commit the real values.
REDIS_URL=rediss://default:replace-me@example.upstash.io:6379
PHONE_HASH_PEPPER=generate-a-long-random-secret
RATE_LIMIT_PEPPER=generate-an-independent-long-random-secret
REPORT_API_KEY=generate-a-separate-random-secret
CORS_ALLOWED_ORIGINS=https://sentinelquantumvanguardaipro.pages.dev
HIGH_RISK_COUNTRIES=MV,SO,VU
GLOBAL_RATE_LIMIT_PER_MINUTE=120
EVALUATE_RATE_LIMIT_PER_MINUTE=30
REPORT_RATE_LIMIT_PER_MINUTE=10

# Dedicated HMAC secret for public pending reports. Keep server-side only.
PUBLIC_REPORT_PEPPER=
PUBLIC_REPORT_RATE_LIMIT_PER_MINUTE=3

# Separate server-side credential for moderation administration only.
MODERATION_API_KEY=generate-an-independent-long-random-secret
MODERATION_RATE_LIMIT_PER_MINUTE=30
