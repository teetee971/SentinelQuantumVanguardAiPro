/*
  Conservative browser security headers for Cloudflare Pages.
  CSP intentionally allows the existing inline scripts/styles while blocking
  object embeds, framing, and mixed content. Tighten script-src after the
  remaining inline handlers are migrated to addEventListener.
*/
/*
  NOTE: Cloudflare Pages applies this file to files under public/ after the
  build copies public assets into frontend/dist/public.
*/
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
X-Frame-Options: DENY
Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
