{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/ai-evaluation-result.schema.json",
  "title": "Sentinel AI Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "version", "suite_version", "evaluations", "overall", "binding"],
  "properties": {
    "model_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "suite_version": { "type": "string", "minLength": 1 },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "dimension", "passed", "score"],
        "properties": {
          "test_id": { "type": "string", "minLength": 1 },
          "dimension": { "type": "string", "enum": ["grounding", "evidence_fidelity", "structured_output", "prompt_injection", "policy_compliance", "robustness", "regression"] },
          "passed": { "type": "boolean" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "details": { "type": "string" }
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "score", "failed_dimensions"],
      "properties": {
        "passed": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "failed_dimensions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "version", "suite_version"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "suite_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
