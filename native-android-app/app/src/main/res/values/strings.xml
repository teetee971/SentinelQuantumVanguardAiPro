    <string name="about_title">Ce que Sentinel fait / ne fait pas</string>
    <string name="about_does_title">Ce que Sentinel FAIT</string>
    <string name="about_does_1">Affiche des informations et flux OSINT publics</string>
    <string name="about_does_2">Fournit des informations pédagogiques sur la cybersécurité</string>
    <string name="about_does_3">Permet certaines vérifications locales sans interception des communications</string>
    <string name="about_does_4">Fonctionne sans compte utilisateur pour les fonctions actuellement présentes</string>

    <string name="about_doesnt_title">Ce que Sentinel NE FAIT PAS</string>
    <string name="about_doesnt_1">Ne fournit pas de protection active contre les cyberattaques</string>
    <string name="about_doesnt_2">N\'intercepte pas les appels et ne lit pas le journal d\'appels</string>
    <string name="about_doesnt_3">Ne modifie pas les paramètres de sécurité de l\'appareil</string>
    <string name="about_doesnt_4">N\'utilise pas de permission téléphonique sensible dans le manifeste actuel</string>
    <string name="about_doesnt_5">Les fonctions locales ne transmettent pas les numéros vérifiés à un service distant</string>

    <string name="about_disclaimer_title">Avertissement</string>
    <string name="about_disclaimer">Cette application est un outil de veille et d\'information. Une classification locale ou une information OSINT ne constitue pas une preuve qu\'un appareil ou un numéro est compromis.</string>

    <string name="compliance_title">Conformité et souveraineté</string>
    <string name="compliance_gdpr_title">Données personnelles</string>
    <string name="compliance_gdpr">Les fonctions locales ne transmettent pas les numéros vérifiés. Toute évolution impliquant un traitement distant devra faire l\'objet d\'une analyse de conformité dédiée.</string>
    <string name="compliance_data_title">Données</string>
    <string name="compliance_data">Les flux OSINT affichés proviennent de sources publiques configurées dans l\'application.</string>
    <string name="compliance_sovereignty_title">Souveraineté</string>
    <string name="compliance_sovereignty">Les fonctions locales ne dépendent pas d\'un backend applicatif. Les flux OSINT nécessitent toutefois l\'accès réseau aux sources publiques configurées.</string>
    <string name="compliance_transparency_title">Transparence</string>
    <string name="compliance_transparency">Le code source est disponible pour audit ; l\'absence de fonctionnalité cachée doit être vérifiée à chaque évolution.</string>
