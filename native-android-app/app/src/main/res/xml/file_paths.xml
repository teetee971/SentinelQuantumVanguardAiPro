<?xml version="1.0" encoding="utf-8"?>
<!--
  Only dedicated app-cache paths are exposed through this non-exported FileProvider:
  sanitized log/SMS exports and the temporary MMS download target used by Android's
  public MMS transport API. No external/shared storage or general app files are exposed.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="sentinel_log_export" path="sentinel_log_export/" />
    <cache-path name="sentinel_sms_export" path="sentinel_sms_export/" />
    <cache-path name="sentinel_mms_download" path="sentinel_mms_download/" />
</paths>
