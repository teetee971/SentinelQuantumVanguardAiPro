{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/evidence.schema.json",
  "title": "Sentinel Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id","kind","observed_at","source_id","confidence"],
  "properties": {
    "evidence_id":{"type":"string","minLength":1,"maxLength":128},
    "kind":{"enum":["observation","inference","hypothesis"]},
    "observed_at":{"type":"string","format":"date-time"},
    "source_id":{"type":"string","minLength":1,"maxLength":128},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "entity_ids":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":128}},
    "content_digest":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}
  }
}
