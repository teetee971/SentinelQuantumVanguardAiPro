                                        "text": "    private fun move(identifier: String, addTo: String, removeFrom: String) {\n        val fingerprint = fingerprint(identifier) ?: return\n        prefs.edit()\n            .putStringSet(addTo, read(addTo) + fingerprint)\n            .putStringSet(removeFrom, read(removeFrom) - fingerprint)\n"
                                    }
                                }
                            }
                        }
                    ],
