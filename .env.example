# Sentinel Quantum Vanguard AI Pro — local environment template
#
# Copy to `.env` (ignored by Git) and fill in local values.
# Never commit real values. Never store production secrets in this repository.
# Deployment secrets belong in GitHub Actions secrets or an approved secret manager.
# See docs/SECURITY_CREDENTIALS.md.

# Optional: PostgreSQL instance used by the local replay-guard integration test.
# Local development database only, never a production connection string.
DATABASE_URL=replace_me_local_postgres_connection_string
